# Since the ".env" file is gitignored, you can use the ".env.example" file to
# build a new ".env" file when you clone the repo. Keep this file up-to-date
# when you add new variables to `.env`.

# This file will be committed to version control, so make sure not to have any
# secrets in it. If you are cloning this repo, create a copy of this file named
# ".env" and populate it with your secrets.

# When adding additional environment variables, the schema in "/src/config/env.ts"
# should be updated accordingly.
# Phantom Connect (embedded Google wallet). Create an app at https://phantom.com/portal
# and add this exact redirect URL under allowed redirects:
#   ${NEXT_PUBLIC_APP_URL}/auth/callback
# Example: http://localhost:3000/auth/callback
# If /login/start returns 400, the app id is wrong or the redirect URL does not match the portal exactly.
NEXT_PUBLIC_PHANTOM_APP_ID=
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com
NEXT_PUBLIC_SOLANA_WS_URL=wss://api.devnet.solana.com
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ADMIN PRIVATE KEY FOR REGTECH PROGRAM
# solana-keygen new --no-bip39-passphrase -o ./admin.json
# then: cat ./admin.json
XCAVATE_ADMIN_PRIVATE_KEY=

# Optional: auto-fund new company Swig vault on registration.
# 200_000_000 = 0.2 SOL
INITIAL_SWIG_FUND_LAMPORTS=200_000_000

# Comma-separated Phantom wallet pubkeys allowed to approve Swig funding requests (admin UI).
NEXT_PUBLIC_XCAVATE_ADMIN_WALLET_ADDRESSES=

# AWS S3 CONFIG FOR UPLOADING IMAGES
XCAV_AWS_S3_ACCESS_KEY=
XCAV_AWS_S3_SECRET_ACCESS_KEY=
XCAV_AWS_S3_BUCKET_NAME=
NEXT_PUBLIC_AWS_REGION=
NEXT_PUBLIC_SOL_USD=
NEXT_PUBLIC_UPLOADED_IMAGE=
DATABASE_URL=